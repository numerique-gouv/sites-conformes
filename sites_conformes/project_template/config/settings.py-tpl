"""
Settings of the {{ project_name }} project, generated by `sites-conformes start`
(sites-conformes {{ sites_conformes_version }}).

Values that change between environments are read from the environment or from
the `.env` file. Reference of the sites-conformes settings:
https://sites-conformes.readthedocs.io/
"""

import os
from pathlib import Path

import dj_database_url
from dotenv import load_dotenv

import sites_conformes

load_dotenv()

BASE_DIR = Path(__file__).resolve().parent.parent
PACKAGE_DIR = Path(sites_conformes.__file__).resolve().parent

SECRET_KEY = os.environ["SECRET_KEY"]
DEBUG = os.getenv("DEBUG", "").casefold() in ("1", "true")
ALLOWED_HOSTS = os.getenv("ALLOWED_HOSTS", "127.0.0.1,.localhost").replace(" ", "").split(",")

INSTALLED_APPS = [{% if media_storage == "s3" %}
    "storages",{% endif %}
    # sites-conformes
    "dsfr",
    "sites_conformes",
    "sites_conformes.customimages",
    "sites_conformes.core",
    "sites_conformes.blog",
    "sites_conformes.events",
    "sites_conformes.forms",
    "sites_conformes.menus",{% if dashboard %}
    "sites_conformes.dashboard",
    "widget_tweaks",{% endif %}{% if media_storage == "db" %}
    "sites_conformes.db_storage",{% endif %}{% if proconnect %}
    "sites_conformes.proconnect",
    "mozilla_django_oidc",{% endif %}
    "wagtailmenus",
    "wagtailmarkdown",
    "wagtail_honeypot",
    # Wagtail
    "wagtail.contrib.forms",
    "wagtail.contrib.redirects",
    "wagtail.contrib.routable_page",
    "wagtail.contrib.settings",
    "wagtail.contrib.typed_table_block",
    "wagtail.embeds",
    "wagtail.sites",
    "wagtail.users",
    "wagtail.snippets",
    "wagtail.documents",
    "wagtail.images",
    "wagtail.search",
    "wagtail.admin",{% if dashboard %}
    "wagtail_2fa",
    "django_otp",
    "django_otp.plugins.otp_totp",{% endif %}{% if languages %}
    "wagtail_localize",
    "wagtail_localize.locales",{% endif %}
    "wagtail",
    "modelcluster",
    "taggit",
    # Django
    "django.contrib.auth",
    "django.contrib.contenttypes",
    "django.contrib.sessions",
    "django.contrib.messages",
    "django.contrib.sitemaps",
    "django.contrib.staticfiles",
]

MIDDLEWARE = [
    "django.middleware.security.SecurityMiddleware",
    "django.contrib.sessions.middleware.SessionMiddleware",
    "django.middleware.common.CommonMiddleware",
    "django.middleware.csrf.CsrfViewMiddleware",
    "django.middleware.locale.LocaleMiddleware",
    "django.contrib.auth.middleware.AuthenticationMiddleware",{% if dashboard %}
    "sites_conformes.dashboard.middleware.VerifyUserStaticFilesMiddleware",{% endif %}
    "django.contrib.messages.middleware.MessageMiddleware",
    "django.middleware.clickjacking.XFrameOptionsMiddleware",
    "wagtail.contrib.redirects.middleware.RedirectMiddleware",
]

ROOT_URLCONF = "config.urls"
WSGI_APPLICATION = "config.wsgi.application"

TEMPLATES = [
    {
        "BACKEND": "django.template.backends.django.DjangoTemplates",
        # Put your own templates in templates/ to override the ones of the package.
        "DIRS": [BASE_DIR / "templates", PACKAGE_DIR / "templates"],
        "APP_DIRS": True,
        "OPTIONS": {
            "context_processors": [
                "django.template.context_processors.debug",
                "django.template.context_processors.request",
                "django.contrib.auth.context_processors.auth",
                "django.contrib.messages.context_processors.messages",
                "wagtail.contrib.settings.context_processors.settings",
                "wagtailmenus.context_processors.wagtailmenus",
                "sites_conformes.core.context_processors.skiplinks",
                "sites_conformes.core.context_processors.mega_menus",
            ],
        },
    },
]

# SQLite by default, to start without installing anything.
# Set DATABASE_URL (postgres://user:password@host:5432/name) to use PostgreSQL.
DATABASES = {"default": dj_database_url.config(default=f"sqlite:///{BASE_DIR / 'db.sqlite3'}")}
DEFAULT_AUTO_FIELD = "django.db.models.BigAutoField"

AUTH_PASSWORD_VALIDATORS = [
    {"NAME": "django.contrib.auth.password_validation.UserAttributeSimilarityValidator"},
    {"NAME": "django.contrib.auth.password_validation.MinimumLengthValidator"},
    {"NAME": "django.contrib.auth.password_validation.CommonPasswordValidator"},
    {"NAME": "django.contrib.auth.password_validation.NumericPasswordValidator"},
]

LANGUAGE_CODE = "fr"
TIME_ZONE = "Europe/Paris"
USE_I18N = True
USE_TZ = True
WAGTAIL_I18N_ENABLED = True
WAGTAIL_CONTENT_LANGUAGES = LANGUAGES = [
    ("fr", "Français"),{% for code, language in languages %}
    ("{{ code }}", "{{ language }}"),{% endfor %}
]

STATIC_URL = "static/"
STATIC_ROOT = BASE_DIR / "staticfiles"
STATICFILES_DIRS = [PACKAGE_DIR / "static"]
{% if media_storage == "db" %}
# Media stored in the database: nothing to keep on disk, fine up to about 1 GB.
STORAGES = {
    "default": {"BACKEND": "sites_conformes.db_storage.storage.DatabaseStorage"},
    "staticfiles": {"BACKEND": "django.contrib.staticfiles.storage.StaticFilesStorage"},
}
MEDIA_URL = "db-storage/"
MEDIA_ROOT = BASE_DIR
{% elif media_storage == "s3" %}
# Media stored in an S3 bucket, configured with the S3_* variables.
# https://django-storages.readthedocs.io/en/latest/backends/amazon-S3.html
S3_ENDPOINT_URL = f"https://{os.environ['S3_HOST']}"
STORAGES = {
    "default": {
        "BACKEND": "storages.backends.s3.S3Storage",
        "OPTIONS": {
            "bucket_name": os.environ["S3_BUCKET_NAME"],
            "access_key": os.environ["S3_KEY_ID"],
            "secret_key": os.environ["S3_KEY_SECRET"],
            "endpoint_url": S3_ENDPOINT_URL,
            "region_name": os.getenv("S3_BUCKET_REGION", "fr"),
            "location": os.getenv("S3_LOCATION", ""),
            "file_overwrite": False,
        },
    },
    "staticfiles": {"BACKEND": "django.contrib.staticfiles.storage.StaticFilesStorage"},
}
MEDIA_URL = f"{S3_ENDPOINT_URL}/"
MEDIA_ROOT = BASE_DIR
{% else %}
MEDIA_URL = "medias/"
MEDIA_ROOT = BASE_DIR / "medias"
{% endif %}
# Page models with many blocks exceed Django's default of 1000 form fields.
DATA_UPLOAD_MAX_NUMBER_FIELDS = 10_000

# Wagtail
WAGTAIL_SITE_NAME = "{{ project_name }}"
WAGTAILADMIN_PATH = "cms-admin/"
WAGTAILSEARCH_BACKENDS = {"default": {"BACKEND": "wagtail.search.backends.database"}}
# Required: the migrations of the package depend on it.
WAGTAILIMAGES_IMAGE_MODEL = "sites_conformes_customimages.CustomImage"

# sites-conformes: host, protocol and port used to build absolute URLs.
HOST_URL = os.getenv("HOST_URL", "localhost")
HOST_PROTO = os.getenv("HOST_PROTO", "http" if DEBUG else "https")
HOST_PORT = os.getenv("HOST_PORT", "8000" if DEBUG else "")
WAGTAILADMIN_BASE_URL = f"{HOST_PROTO}://{HOST_URL}" + (f":{HOST_PORT}" if HOST_PORT else "")
{% if dashboard %}
# Admin dashboard of sites-conformes: DSFR login page, notifications, tutorials, 2FA screens.
WAGTAILADMIN_USER_PASSWORD_RESET_FORM = "sites_conformes.dashboard.forms.DsfrPasswordResetForm"  # nosec B105
WAGTAIL_ENABLE_UPDATE_CHECK = False  # replaced by the check of the latest sites-conformes release below
NOTIFICATIONS_FILE_URL = (
    "https://raw.githubusercontent.com/numerique-gouv/sites-conformes/refs/heads/main/notifications.json"
)
LATEST_RELEASE_URL = "https://api.github.com/repos/numerique-gouv/sites-conformes/releases/latest"
RELEASES_URL = "https://github.com/numerique-gouv/sites-conformes/releases"
ADVERTISE_LATEST_VERSION = True
SF_DISABLE_TUTORIALS = False

# Two-factor authentication of the admin users. https://wagtail-2fa.readthedocs.io/
WAGTAIL_2FA_REQUIRED = {{ two_fa }}
WAGTAIL_2FA_OTP_TOTP_NAME = WAGTAIL_SITE_NAME
PROCONNECT_ACTIVATED = {{ proconnect }}
{% endif %}{% if proconnect %}
# ProConnect login for the admin, next to the password login.
# The identifiers are read from the PROCONNECT_* variables.
AUTHENTICATION_BACKENDS = [
    "django.contrib.auth.backends.ModelBackend",
    "sites_conformes.proconnect.backends.OIDCAuthenticationBackend",
]
PROCONNECT_DOMAIN = os.getenv("PROCONNECT_DOMAIN", "fca.integ01.dev-agentconnect.fr")
PROCONNECT_API_ROOT = f"https://{PROCONNECT_DOMAIN}/api/v2"
OIDC_RP_CLIENT_ID = os.getenv("PROCONNECT_CLIENT_ID", "")
OIDC_RP_CLIENT_SECRET = os.getenv("PROCONNECT_CLIENT_SECRET", "")
OIDC_RP_SCOPES = "openid given_name usual_name email siret uid"
OIDC_RP_SIGN_ALGO = "RS256"
OIDC_STORE_ID_TOKEN = True
OIDC_CREATE_USER = True
OIDC_OP_JWKS_ENDPOINT = f"{PROCONNECT_API_ROOT}/jwks"
OIDC_OP_AUTHORIZATION_ENDPOINT = f"{PROCONNECT_API_ROOT}/authorize"
OIDC_OP_TOKEN_ENDPOINT = f"{PROCONNECT_API_ROOT}/token"
OIDC_OP_USER_ENDPOINT = f"{PROCONNECT_API_ROOT}/userinfo"
OIDC_OP_LOGOUT_ENDPOINT = f"{PROCONNECT_API_ROOT}/session/end"
OIDC_AUTH_REQUEST_EXTRA_PARAMS = {"acr_values": "eidas1"}
OIDC_REDIRECT_ALLOWED_HOSTS = ALLOWED_HOSTS
USER_OIDC_ESSENTIAL_CLAIMS = ["email"]
PROCONNECT_USER_CREATION_FILTER = None
LASUITE_DOMAINE_API_KEY = os.getenv("LASUITE_DOMAINE_API_KEY")
LOGIN_URL = f"/{WAGTAILADMIN_PATH}login/"
LOGOUT_URL = "/oidc/logout/"
LOGIN_REDIRECT_URL = LOGOUT_REDIRECT_URL = "/"
{% endif %}{% if sentry %}
# Sentry: nothing is sent while SENTRY_DSN is empty.
if sentry_dsn := os.getenv("SENTRY_DSN"):
    import sentry_sdk

    sentry_sdk.init(dsn=sentry_dsn, environment=os.getenv("SENTRY_ENVIRONMENT", "production"))
{% endif %}