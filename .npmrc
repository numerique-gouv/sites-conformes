# Dependency cooldown: refuse npm package versions published within the last N
# days so CVEs and supply-chain advisories have time to surface before we
# adopt a version (requires npm 11.10+).
min-release-age=7

# Per-package opt-out: list package names (or minimatch globs) that may bypass
# the cooldown when you need an urgent fix published inside the window. Example:
# min-release-age-exclude[]=axios
